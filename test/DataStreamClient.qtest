#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires HttpServer
%requires Logger
%requires Mime
%requires yaml
%requires ../qlib/DataStreamClient.qm
%requires ../qlib/DataStreamUtil.qm
%requires QUnit

%exec-class DataStreamClientTest

class YamlHandler inherits AbstractHttpRequestHandler {
    private {
        *string m_data;
        string m_mime;
    }

    constructor(string mime, *string str) {
        m_mime = mime;
        m_data = str;
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method == "DELETE") {
            return makeResponse(404, m_data ?? make_yaml({"error": "not found"}),
                {"Content-Type": m_mime});
        } else if (hdr.method == "POST") {
            # Echo back the parsed body
            auto parsed = body ? parse_yaml(body) : {};
            return makeResponse(200, make_yaml({"received": parsed}),
                {"Content-Type": m_mime});
        } else {
            return makeResponse(200, m_data ?? make_yaml({"status": "ok"}),
                {"Content-Type": m_mime});
        }
    }
}

#! Handler that echoes DataStream records back; stores received records in a shared buffer
class DataStreamEchoHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex mtx();
        list<auto> records = ();
    }

    constructor() : AbstractHttpRequestHandler() {
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method == "POST") {
            # Parse YAML body - sendDataStream sends YAML-encoded data as multiple concatenated
            # YAML documents (each chunk = one %YAML 1.2 document)
            list<auto> parsed = ();
            if (body) {
                string body_str = body.typeCode() == NT_BINARY ? body.toString("UTF-8") : string(body);
                # Split on YAML document boundaries
                list<auto> parts = body_str.split("%YAML");
                foreach string part in (parts) {
                    if (part.val()) {
                        parsed += parse_yaml("%YAML" + part);
                    }
                }
            }
            {
                mtx.lock();
                on_exit mtx.unlock();
                records += parsed;
            }
            int count;
            {
                mtx.lock();
                on_exit mtx.unlock();
                count = records.size();
            }
            return makeResponse(200, make_yaml({"rows": count, "status": "ok"}),
                {"Content-Type": MimeTypeYaml});
        } else if (hdr.method == "GET") {
            # Return stored records as YAML
            list<auto> data;
            {
                mtx.lock();
                on_exit mtx.unlock();
                data = records;
            }
            return makeResponse(200, make_yaml(data), {"Content-Type": MimeTypeYaml});
        } else if (hdr.method == "DELETE") {
            # Clear stored records
            {
                mtx.lock();
                on_exit mtx.unlock();
                records = ();
            }
            return makeResponse(200, make_yaml({"status": "cleared"}), {"Content-Type": MimeTypeYaml});
        }

        return makeResponse(405, make_yaml({"error": "method not allowed"}), {"Content-Type": MimeTypeYaml});
    }
}

#! Handler that returns 500 error for DataStream error recovery testing
class DataStreamErrorHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, make_yaml({"err": "DS-ERROR", "desc": "simulated server error"}),
            {"Content-Type": MimeTypeYaml});
    }
}

class ErrorHandler inherits AbstractHttpRequestHandler {
    private {
        *string m_data;
        string m_mime;
    }

    constructor(string mime, *string str) {
        m_mime = mime;
        m_data = str;
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method == "DELETE") {
            return makeResponse(404, m_data ?? binary(body), {"Content-Type": m_mime});
        } else {
            return makeResponse(200, m_data ?? binary(body), {"Content-Type": m_mime});
        }
    }
}

class DataStreamClientTest inherits QUnit::Test {
    private {
        HttpServer m_http;
        int port;
    }

    constructor() : Test("DataStreamClient test", "1.0") {
        addTestCase("base test", \testDataStreamClient());
        addTestCase("constructor options", \testConstructorOptions());
        addTestCase("http version cap", \testHttpVersionCap());
        addTestCase("connection test", \testConnection());
        addTestCase("message classes", \testMessageClasses());
        addTestCase("content encoding", \testContentEncoding());
        addTestCase("error handling", \testErrorHandling());
        addTestCase("datastream keep-alive", \testDataStreamKeepAlive());
        addTestCase("datastream error recovery", \testDataStreamErrorRecovery());

        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new TestAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        m_http = new HttpServer(http_opts);
        m_http.setHandler("/api", "/api", MimeTypeText, new ErrorHandler(MimeTypeText));
        m_http.setHandler("/yaml", "/yaml", MimeTypeYaml, new YamlHandler(MimeTypeYaml));
        m_http.setHandler("/ds-echo", "/ds-echo", MimeTypeYaml, new DataStreamEchoHandler());
        m_http.setHandler("/ds-error", "/ds-error", MimeTypeYaml, new DataStreamErrorHandler());
        port = m_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());

        delete m_http;
    }

    testDataStreamClient() {
        DataStreamClient client({"url": "http://localhost:" + port}, True);

        assertEq(True, client instanceof DataStreamClient);

        hash<auto> info;
        assertThrows("DESERIALIZATION-ERROR", \client.del(), ("/api", "NOTHING", \info));
        assertEq(404, info."response-code");

        client.get("/api", NOTHING, \info);
        # 204 No Content is returned for responses with empty body
        assertEq(204, info."response-code");
    }

    testConstructorOptions() {
        # Test with various options
        hash<auto> opts = {
            "url": "http://localhost:" + port,
            "connect_timeout": 5000,
            "timeout": 30000,
        };

        DataStreamClient client(opts, True);
        assertEq(True, client instanceof DataStreamClient);

        # Test default headers
        client.addDefaultHeaders({"X-Custom": "value"});
    }

    testHttpVersionCap() {
        DataStreamClient client_default({"url": "http://localhost:" + port}, True);
        assertEq("1.1", client_default.getEffectiveHttpVersion());

        DataStreamClient client_auto({"url": "http://localhost:" + port, "http_version": "auto"}, True);
        assertEq("1.1", client_auto.getEffectiveHttpVersion());

        DataStreamClient client_two({"url": "http://localhost:" + port, "http_version": "2.0"}, True);
        assertEq("1.1", client_two.getEffectiveHttpVersion());

        DataStreamClient client_one_one({"url": "http://localhost:" + port, "http_version": "1.1"}, True);
        assertEq("1.1", client_one_one.getEffectiveHttpVersion());

        DataStreamClient client_one_zero({"url": "http://localhost:" + port, "http_version": "1.0"}, True);
        assertEq("1.0", client_one_zero.getEffectiveHttpVersion());

        code bad_ctor = sub () {
            DataStreamClient bad({"url": "http://localhost:" + port, "http_version": "3.0"}, True);
            delete bad;
        };
        assertThrows("HTTP-VERSION-ERROR", bad_ctor);
    }

    testConnection() {
        # Test DataStreamConnection
        string url = "ds://localhost:" + port + "/";
        DataStreamConnection conn("test", "test", url, {"monitor": False});
        DataStreamClient client = conn.get(False);
        assertEq(True, client instanceof DataStreamClient);

        # Test dss scheme
        url = "dss://localhost:" + port + "/";
        conn = new DataStreamConnection("test", "test", url, {"monitor": False});
        client = conn.get(False);
        assertEq(True, client instanceof DataStreamClient);

        # Test connection type
        assertEq("dss", conn.getType());

        # Test connection serialization
        DataStreamConnection conn2 = Serializable::deserialize(conn.serialize());
        assertEq(conn.url, conn2.url);
    }

    testMessageClasses() {
        # Test DataStreamSendMessage
        TestSendMessage send_msg();
        int count = 0;
        while (True) {
            auto data = send_msg.sendData();
            if (!exists data) break;
            count++;
            assertTrue(count <= 3);
        }
        assertEq(3, count);

        # Test DataStreamRecvMessage
        TestRecvMessage recv_msg();
        recv_msg.recvData({"item": 1});
        recv_msg.recvData({"item": 2});
        recv_msg.recvDataDone();
        assertEq(2, recv_msg.getReceivedCount());
        assertTrue(recv_msg.isDone());

        # Test with error
        TestRecvMessage recv_msg2();
        recv_msg2.recvDataDone("test error");
        assertTrue(recv_msg2.isDone());
        assertEq("test error", recv_msg2.getError());

        # Test DataStreamMessage (combined send/recv)
        TestMessage msg();
        assertEq(True, msg instanceof DataStreamSendMessage);
        assertEq(True, msg instanceof DataStreamRecvMessage);
    }

    testContentEncoding() {
        DataStreamClient client({"url": "http://localhost:" + port}, True);

        # Test setting content encoding
        client.setContentEncoding("gzip");
        client.setContentEncoding("auto");
    }

    testErrorHandling() {
        DataStreamClient client({"url": "http://localhost:" + port});

        hash<auto> info;

        # Test 404 response
        try {
            client.del("/api", NOTHING, \info);
        } catch (hash<ExceptionInfo> ex) {
            assertEq(404, info."response-code");
        }
    }

    testDataStreamKeepAlive() {
        # Test multiple DataStream operations on the same keep-alive connection
        DataStreamClient client({"url": "http://localhost:" + port, "timeout": 30000}, True);

        # Clear any previous state
        hash<auto> info;
        client.del("/ds-echo", NOTHING, \info);

        # Operation 1: send 3 records via sendDataStream
        int send_count = 0;
        list<auto> send_data1 = ({"name": "rec1", "val": 1}, {"name": "rec2", "val": 2}, {"name": "rec3", "val": 3});
        code sender1 = auto sub() {
            if (send_count >= send_data1.size()) {
                return NOTHING;
            }
            return send_data1[send_count++];
        };
        hash<auto> resp1 = client.sendDataStream(sender1, "POST", "/ds-echo", 20s, \info);
        assertEq(200, resp1.status_code, "sendDataStream POST should return 200");
        assertEq(3, resp1.body.rows, "server should have stored 3 records");

        # Operation 2: GET the stored records
        hash<auto> resp2 = client.get("/ds-echo", NOTHING, \info);
        assertEq(200, info."response-code", "GET should return 200");
        assertEq(NT_LIST, resp2.body.typeCode(), "GET response body should be a list");
        assertEq(3, resp2.body.size(), "should retrieve 3 records");

        # Operation 3: send 2 more records
        send_count = 0;
        list<auto> send_data2 = ({"name": "rec4", "val": 4}, {"name": "rec5", "val": 5});
        code sender2 = auto sub() {
            if (send_count >= send_data2.size()) {
                return NOTHING;
            }
            return send_data2[send_count++];
        };
        hash<auto> resp3 = client.sendDataStream(sender2, "POST", "/ds-echo", 20s, \info);
        assertEq(200, resp3.status_code, "second sendDataStream should return 200");
        assertEq(5, resp3.body.rows, "server should now have 5 records");

        # Operation 4: GET all records
        hash<auto> resp4 = client.get("/ds-echo", NOTHING, \info);
        assertEq(200, info."response-code", "second GET should return 200");
        assertEq(5, resp4.body.size(), "should retrieve all 5 records");

        # Verify data integrity of retrieved records
        assertEq("rec1", resp4.body[0].name, "first record name");
        assertEq(5, resp4.body[4].val, "last record value");

        if (m_options.verbose > 1) {
            printf("DataStream keep-alive: 4 operations on same connection OK\n");
        }
    }

    testDataStreamErrorRecovery() {
        # Test that a DataStream error doesn't break the keep-alive connection
        DataStreamClient client({"url": "http://localhost:" + port, "timeout": 30000}, True);

        hash<auto> info;

        # Operation 1: successful GET to establish connection
        client.get("/yaml", NOTHING, \info);
        assertEq(200, info."response-code", "initial GET should succeed");

        # Operation 2: request to error handler - should get 500
        bool got_error = False;
        try {
            client.get("/ds-error", NOTHING, \info);
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            # DataStreamClient throws on error responses
        }
        # Either we got an exception or a 500 response
        assertTrue(got_error || info."response-code" == 500, "error handler should return 500 or throw");

        # Operation 3: subsequent request on same connection should still work
        client.get("/yaml", NOTHING, \info);
        assertEq(200, info."response-code", "GET after error should succeed on same connection");

        if (m_options.verbose > 1) {
            printf("DataStream error recovery: connection survived error OK\n");
        }
    }

    log(string msg) {
        if (m_options.verbose > 2) {
            vprintf(msg + "\n", argv);
        }
    }
}

class TestSendMessage inherits DataStreamSendMessage {
    private {
        int count = 0;
    }

    private auto sendDataImpl() {
        if (count < 3) {
            return {"item": count++};
        }
        return NOTHING;
    }
}

class TestRecvMessage inherits DataStreamRecvMessage {
    private {
        int received_count = 0;
        bool done = False;
        *string error;
    }

    private nothing recvDataImpl(auto data) {
        received_count++;
    }

    private nothing recvDataDoneImpl(*string err) {
        done = True;
        error = err;
    }

    int getReceivedCount() {
        return received_count;
    }

    bool isDone() {
        return done;
    }

    *string getError() {
        return error;
    }
}

class TestMessage inherits DataStreamMessage {
    private {
        int send_count = 0;
        int recv_count = 0;
    }

    private auto sendDataImpl() {
        if (send_count < 2) {
            return {"item": send_count++};
        }
        return NOTHING;
    }

    private nothing recvDataImpl(auto data) {
        recv_count++;
    }
}

class TestAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("test", new LoggerLayoutPattern("%d T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                print(params);
                break;
        }
    }
}
