#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../qlib/DataStreamRequestHandler.qm
%requires ../qlib/DataStreamUtil.qm
%requires yaml
%requires Mime
%requires QUnit

%exec-class DataStreamRequestHandlerTest

class TestDataStreamRequestHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> received_data = ();
        list<auto> data_to_send;
        int send_index = 0;
    }

    constructor(hash cx, *hash ah, list<auto> send_data = ()) : AbstractDataStreamRequestHandler(cx, ah) {
        data_to_send = send_data;
    }

    auto sendDataImpl() {
        if (send_index < data_to_send.size()) {
            return data_to_send[send_index++];
        }
        return NOTHING;
    }

    nothing recvDataImpl(auto data) {
        received_data += data;
    }

    list<auto> getReceivedData() {
        return received_data;
    }
}

class EchoDataStreamRequestHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> buffer = ();
        int echo_index = 0;
    }

    constructor(hash cx, *hash ah) : AbstractDataStreamRequestHandler(cx, ah) {
    }

    auto sendDataImpl() {
        if (echo_index < buffer.size()) {
            return buffer[echo_index++];
        }
        return NOTHING;
    }

    nothing recvDataImpl(auto data) {
        buffer += data;
    }
}

class ErrorDataStreamRequestHandler inherits AbstractDataStreamRequestHandler {
    constructor(hash cx, *hash ah) : AbstractDataStreamRequestHandler(cx, ah) {
    }

    auto sendDataImpl() {
        throw "SEND-ERROR", "Test send error";
    }

    nothing recvDataImpl(auto data) {
        throw "RECV-ERROR", "Test receive error";
    }
}

class DataStreamRequestHandlerTest inherits QUnit::Test {
    constructor() : Test("DataStreamRequestHandler test", "1.0") {
        addTestCase("base test", \testDataStreamRequestHandler());
        addTestCase("receive data", \testReceiveData());
        addTestCase("send data", \testSendData());
        addTestCase("error response", \testErrorResponse());
        addTestCase("response headers", \testResponseHeaders());
        addTestCase("data types", \testDataTypes());
        addTestCase("empty data", \testEmptyData());
        addTestCase("large data", \testLargeData());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    testDataStreamRequestHandler() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };
        TestDataStreamRequestHandler handler(cx);

        assertEq(True, handler instanceof AbstractDataStreamRequestHandler);
    }

    testReceiveData() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };
        TestDataStreamRequestHandler handler(cx);

        # Simulate receiving data
        list<auto> test_data = (
            {"item": 1, "value": "first"},
            {"item": 2, "value": "second"},
            {"item": 3, "value": "third"},
        );

        foreach auto item in (test_data) {
            # Simulate what recvImpl would do
            handler.recvDataImpl(item);
        }

        list<auto> received = handler.getReceivedData();
        assertEq(3, received.size());
        assertEq(test_data[0], received[0]);
        assertEq(test_data[1], received[1]);
        assertEq(test_data[2], received[2]);
    }

    testSendData() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };

        list<auto> data_to_send = (
            {"response": 1},
            {"response": 2},
        );

        TestDataStreamRequestHandler handler(cx, NOTHING, data_to_send);

        # Get all data that would be sent
        list<auto> sent = ();
        while (True) {
            auto data = handler.sendDataImpl();
            if (!exists data) break;
            push sent, data;
        }

        assertEq(2, sent.size());
        assertEq(data_to_send[0], sent[0]);
        assertEq(data_to_send[1], sent[1]);
    }

    testErrorResponse() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {},  # Missing DataStreamAccept header
        };
        TestDataStreamRequestHandler handler(cx);

        # Should return error response for missing accept header
        *hash<auto> error = handler.getErrorResponse();
        assertTrue(error.hasKey("code"));
        assertEq(406, error.code);
    }

    testResponseHeaders() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };
        TestDataStreamRequestHandler handler(cx);

        hash<auto> response = handler.getResponseHeaderMessageImpl();
        assertEq(200, response.code);
        assertTrue(response.hasKey("hdr"));
        assertEq("chunked", response.hdr."Transfer-Encoding");
    }

    testDataTypes() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };

        # Test with various data types
        list<auto> test_data = (
            42,
            3.14,
            "string value",
            True,
            (1, 2, 3),
            {"key": "value"},
            now(),
            <48656c6c6f>,  # binary
        );

        TestDataStreamRequestHandler handler(cx, NOTHING, test_data);

        # All data types should be sendable
        list<auto> sent = ();
        while (True) {
            auto data = handler.sendDataImpl();
            if (!exists data) break;
            push sent, data;
        }

        assertEq(test_data.size(), sent.size());
    }

    testEmptyData() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };

        # Test with empty data
        TestDataStreamRequestHandler handler(cx, NOTHING, ());

        auto data = handler.sendDataImpl();
        assertEq(NOTHING, data);
    }

    testLargeData() {
        hash<auto> cx = {
            "socketobject": new Socket(),
            "hdr": {
                DataStreamAccept.lwr(): MimeTypeYaml,
            },
        };

        # Generate large data
        list<auto> large_data = ();
        for (int i = 0; i < 100; i++) {
            large_data += {
                "index": i,
                "data": strmul("x", 1000),
            };
        }

        TestDataStreamRequestHandler handler(cx, NOTHING, large_data);

        int count = 0;
        while (True) {
            auto data = handler.sendDataImpl();
            if (!exists data) break;
            count++;
        }

        assertEq(100, count);
    }
}
