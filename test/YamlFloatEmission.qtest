# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%requires QUnit
%requires yaml
%exec-class YamlFloatEmissionTest

class YamlFloatEmissionTest inherits QUnit::Test {
    constructor() : Test("YAML document float emission", "1.0") {
        addTestCase("finite float round trips", \finiteTest());
        addTestCase("special floats", \specialTest());
        addTestCase("schema bounds and numeric strings", \schemaTest());
        set_return_value(main());
    }

    private finiteTest() {
        foreach int flags in (YAML::Yaml1_1, YAML::Yaml1_2, YAML::Canonical) {
            foreach float value in (0.0, -0.0, 1.0, -1.0, 1e9, -1e9, 123456789.0,
                    1e17, 1e19, -1e19, 1.0000000000000002, 0.1, M_PI,
                    1.7976931348623157e308, -1.7976931348623157e308,
                    2.2250738585072014e-308, 4.9406564584124654e-324) {
                string yaml = make_yaml(value, flags);
                auto actual = parse_yaml(yaml);
                assertEq(Type::Float, actual.type(), yaml);
                # Seventeen significant digits distinguish adjacent doubles and signed zero.
                assertEq(sprintf("%+.17g", value), sprintf("%+.17g", actual), yaml);
                YamlDocumentIterator iter(yaml);
                assertTrue(iter.next());
                assertEq(sprintf("%+.17g", value), sprintf("%+.17g", iter.getValue()));
                assertFalse(iter.next());
            }
        }
    }

    private specialTest() {
        foreach float value in (@inf@, -@inf@, @nan@) {
            string yaml = make_yaml(value);
            assertRegex(value.nanp() ? "\\.nan" : "\\.inf", yaml);
            auto actual = parse_yaml(yaml);
            assertEq(Type::Float, actual.type());
            if (value.nanp()) {
                assertTrue(actual.nanp());
            } else {
                assertEq(value, actual);
            }
        }
    }

    private schemaTest() {
        hash<auto> schema = {"type": "number", "minimum": -1e9, "maximum": 1e9,
            "description": "1e+09.0", "example": "1000000000.0"};
        hash<auto> actual = parse_yaml(make_yaml(schema));
        assertEq(schema, actual);
        assertEq(Type::Float, actual.maximum.type());
        assertEq(Type::String, actual.description.type());
        assertEq(Type::String, actual.example.type());
    }
}
